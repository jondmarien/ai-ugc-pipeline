# YouTube OAuth2 credentials (from Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID_HERE
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET_HERE

# TikTok API credentials (from TikTok for Developers → Manage Apps)
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY_HERE
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET_HERE

# Instagram Graph API (new-post detection / relay poll)
# Same values as dashboard/.env — or use `bun run publish:auth meta` → renderer/.secrets/meta.json
IG_ACCESS_TOKEN=
IG_USER_ID=
# META_APP_SECRET=   # or IG_APP_SECRET — enables appsecret_proof
# IG_TARGET_USERNAME=chron0s_cyb3r_w0rld.ai

# Discord relay (Instagram post notifications) — use webhook OR bot + channel
# Fixed ops targets (Chronus server): guild 150356208589602817, channel 1522416855061495848
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=1522416855061495848
DISCORD_GUILD_ID=150356208589602817
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...