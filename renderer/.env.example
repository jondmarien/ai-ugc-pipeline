# YouTube OAuth2 credentials (from Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID_HERE
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET_HERE

# TikTok API credentials (from TikTok for Developers → Manage Apps)
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY_HERE
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET_HERE

# Discord relay (Instagram post notifications) — use webhook OR bot + channel
# Target channel example: 1522416855061495848 in guild 150356208589602817
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
